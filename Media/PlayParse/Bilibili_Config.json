{
	// 本配置沿用扩展支持的 // 注释格式。修改后重启 PotPlayer，使扩展重新读取。
	// true 为开启，false 为关闭。
	// qn=122 无需额外配置开关，需片源提供 4K SDR增强且账号具备相应观看权限。
	// 单集播放链接可使用 ?qn=122 指定该画质。

	// 填写账号 Cookie；留空时使用未登录权限。
	"cookie": "",

	// 直播分区列表的加载数量上限，默认 200；按接口分页，实际数量可能略超过。
	"maxliveroom": 200,

	"danmaku": {
		// 是否启用弹幕及转换后的字幕；按 Alt+H 可显示/隐藏。
		"enable": true,
		// 填写可用的弹幕/字幕转换服务地址；不使用转换服务时可改为空字符串。
		// 下方旧示例地址已停用，当前扩展会自动跳过；需要此功能请换成可用服务。
		"server": "https://subtitle.chen310.repl.co",
		// 弹幕字体。
		"font": "微软雅黑",
		// 弹幕字号，默认 30。
		"fontSize": 30.0,
		// 弹幕不透明度，范围 0.0 ~ 1.0，数值越大越不透明。
		"opacity": 0.8,
		// 弹幕显示区域占画面高度的比例，范围 0.0 ~ 1.0。
		"displayArea": 0.8,
		// 单条弹幕显示时长，单位为秒。
		"stayTime": 15.0
	},

	// 播放单 P 视频时是否加载相关推荐；关闭可减少一次列表接口请求。
	"showRecommendedVideos": true,

	// 是否获取视频章节和字幕列表，默认开启。
	// 关闭可少一次接口请求，但不会加载章节和该接口提供的字幕信息。
	// 字幕转换还需 danmaku.enable=true 且配置可用的 danmaku.server；弹幕本身不受此开关影响。
	"loadPlayerInfo": true,

	// 是否逐档请求非 DASH 的 MP4 画质，默认关闭，仅列出实际取得的画质。
	// 开启会增加串行接口请求及解析等待；DASH 画质列表不受此开关影响。
	"enumerateProgressiveQualities": false,

	// 整季精简选集列表是否包含花絮、预告等额外分组，默认关闭，仅列正片。
	// 开启后合并额外分组，并按 ep_id 去重。
	"bangumiIncludeExtras": false,

	// 调试模式：开启控制台，输出请求耗时、缓存、画质和 CDN 主机摘要。
	// 日常使用建议关闭，减少逐条日志输出。
	"debug": false
}
